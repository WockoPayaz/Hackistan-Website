+.journey[data-enhanced="true"] .stage { position: sticky; top: 0; height: 100dvh; overflow: clip; }
+.journey[data-enhanced="true"] .travel { display: block; height: var(--scroll-distance); pointer-events: none; }
+.journey[data-enhanced="true"] .now { margin-top: -100dvh; z-index: 2; }
