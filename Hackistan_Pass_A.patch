 .journey { position: relative; }
 .stage { position: relative; }
-.journey[data-enhanced="true"] { height: calc(var(--scene-height) + var(--scroll-distance)); }
-.journey[data-enhanced="true"] .stage { position: sticky; top: 0; height: var(--scene-height); overflow: clip; }
